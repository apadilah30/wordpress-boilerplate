{
    "name": "your-org/wordpress-boilerplate",
    "type": "project",
    "license": "MIT",
    "description": "WordPress boilerplate: Bedrock + FrankenPHP + Docker with hardened security, daily backups, CI/CD.",
    "homepage": "https://example.com",
    "authors": [
        {
            "name": "Your Team",
            "email": "team@example.com"
        }
    ],
    "keywords": ["bedrock", "wordpress", "frankenphp", "docker", "elementor"],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "roots/wordpress-core-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        },
        {
            "type": "path",
            "url": "plugins-custom/*",
            "options": { "symlink": false }
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer/installers": "^2.2",
        "vlucas/phpdotenv": "^5.6",
        "oscarotero/env": "^2.1",
        "roots/bedrock-autoloader": "^1.0",
        "roots/bedrock-disallow-indexing": "^2.0",
        "roots/wordpress": "6.9.7",
        "roots/wp-config": "1.0.0",
        "roots/wp-password-bcrypt": "1.1.0",
        "wpackagist-plugin/elementor": "3.35.9",
        "wpackagist-plugin/elementskit-lite": "4.0.1",
        "wpackagist-plugin/wordfence": "8.0.2",
        "wpackagist-plugin/wp-super-cache": "1.12.4",
        "wpackagist-plugin/wordpress-seo": "23.7",
        "wpackagist-plugin/contact-form-7": "6.0.2",
        "wpackagist-plugin/updraftplus": "1.24.12",
        "wpackagist-plugin/wps-hide-login": "1.9.16.5",
        "wpackagist-plugin/redirection": "5.4.2",
        "wpackagist-plugin/custom-post-type-ui": "1.19.3",
        "wpackagist-plugin/advanced-custom-fields": "6.8.8",
        "wpackagist-plugin/polylang": "3.8.7",
        "wpackagist-plugin/loco-translate": "2.8.8",
        "wpackagist-plugin/shortcodes-ultimate": "7.8.4",
        "wpackagist-plugin/members": "3.2.26",
        "boilerplate/wp-boilerplate-announcement": "*"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "roave/security-advisories": "dev-latest"
    },
    "extra": {
        "installer-paths": {
            "web/app/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
            "web/app/plugins/{$name}/":    ["type:wordpress-plugin"],
            "web/app/themes/{$name}/":     ["type:wordpress-theme"]
        },
        "wordpress-install-dir": "web/wp"
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"copy('.env.example', '.env');\""
        ],
        "test": [
            "phpcs",
            "phpstan analyse"
        ],
        "lint": [
            "phpcs"
        ],
        "analyse": [
            "phpstan analyse"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
