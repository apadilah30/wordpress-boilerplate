# ==============================================================================
# WordPress Boilerplate — Environment Variables
# Copy ke .env (dev) atau .env.production (prod).
# NEVER commit real values.
# ==============================================================================

# --- Environment ---
# development | staging | production
WP_ENV=development

# --- URLs & ports (dev) ---
# Kalau port 80/443 di host lu udah dipakai (mis. XAMPP), ubah HTTP_PORT/HTTPS_PORT.
# Jangan lupa update WP_HOME kalau port bukan 80 (mis. WP_HOME=http://localhost:8080)
HTTP_PORT=80
HTTPS_PORT=443
WP_HOME=http://localhost
WP_SITEURL=${WP_HOME}/wp

# --- WP admin (dipakai scripts/dev-init.sh saat first-time install) ---
WP_SITE_TITLE="WordPress Boilerplate"
WP_ADMIN_USER=owner
WP_ADMIN_PASSWORD=changeme123
WP_ADMIN_EMAIL=admin@example.com

# --- Database ---
# Nama service di docker-compose = 'db'
DB_HOST=db
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change_me_to_strong_random_string
DB_ROOT_PASSWORD=change_me_to_another_strong_random_string
DB_PREFIX=wp_

# --- WordPress salts (generate baru dari https://roots.io/salts.html) ---
AUTH_KEY='generate-me'
SECURE_AUTH_KEY='generate-me'
LOGGED_IN_KEY='generate-me'
NONCE_KEY='generate-me'
AUTH_SALT='generate-me'
SECURE_AUTH_SALT='generate-me'
LOGGED_IN_SALT='generate-me'
NONCE_SALT='generate-me'

# --- Redis object cache ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- FrankenPHP ---
# 0 = mode standard (default, kompatibel semua plugin)
# 1 = worker mode (perf boost 2-4x, butuh testing kompatibilitas plugin)
FRANKENPHP_WORKER_MODE=0
# Server name yang di-serve Caddy. Untuk dev pakai 'localhost',
# untuk prod pakai domain lu (misal 'example.com').
SERVER_NAME=localhost

# --- Backup ---
# Jadwal backup harian (format cron). Default: 03:00 setiap hari.
# Backup mencakup: DB dump + seluruh project source + uploads.
BACKUP_CRON="0 3 * * *"
# Berapa hari backup disimpan sebelum dihapus otomatis (default: 30 hari = 1 bulan)
BACKUP_RETENTION_DAYS=30

# --- Hide login (WPS Hide Login) ---
# Ubah slug URL admin. Default WP: /wp-login.php
# Kalau kosong, plugin pakai default-nya.
WP_LOGIN_SLUG=

# --- Deployment (dipakai deploy.sh, tidak dibaca WP) ---
# ghcr.io/OWNER/REPO
DEPLOY_IMAGE=ghcr.io/your-org/wordpress-boilerplate
DEPLOY_TAG=latest
