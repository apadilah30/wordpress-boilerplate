<?xml version="1.0"?>
<ruleset name="Boilerplate">
    <description>WordPress Coding Standards for this boilerplate.</description>

    <file>web/app/mu-plugins</file>
    <file>web/app/themes/starter</file>
    <file>plugins-custom</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/web/wp/*</exclude-pattern>
    <exclude-pattern>*/web/app/plugins/*</exclude-pattern>
    <exclude-pattern>*/web/app/mu-plugins/bedrock-disallow-indexing/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress-Core">
        <exclude name="WordPress.Files.FileName"/>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="boilerplate-starter"/>
                <element value="wp-boilerplate-announcement"/>
            </property>
        </properties>
    </rule>

    <config name="testVersion" value="8.2-"/>
</ruleset>
